#!/bin/sh
set -eu

# ARO Desktop (Tauri) - Debian post-install script
# libstudy is stored/updated in the user's app data directory at runtime.

# NOTE:
# We intentionally do NOT run apt/dpkg inside maintainer scripts.
# Instead we check common runtime deps and print a helpful hint if missing.

missing_pkgs=""

have_pkg() {
	# Usage: have_pkg <package_name>
	# Returns 0 if installed.
	pkg="$1"
	if command -v dpkg-query >/dev/null 2>&1; then
		dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed"
		return $?
	fi
	return 1
}

add_missing() {
	pkg="$1"
	if [ -z "$missing_pkgs" ]; then
		missing_pkgs="$pkg"
	else
		missing_pkgs="$missing_pkgs $pkg"
	fi
}

# WebKitGTK runtime: prefer 4.1, fall back to 4.0 (Debian 12).
if ! have_pkg "libwebkit2gtk-4.1-0" && ! have_pkg "libwebkit2gtk-4.0-37"; then
	# Suggest both; apt will install the right one for the distro.
	add_missing "libwebkit2gtk-4.1-0"
	add_missing "libwebkit2gtk-4.0-37"
fi

# AppIndicator runtime: prefer Ayatana, fall back to legacy appindicator.
if ! have_pkg "libayatana-appindicator3-1" && ! have_pkg "libappindicator3-1"; then
	add_missing "libayatana-appindicator3-1"
	add_missing "libappindicator3-1"
fi

if [ -n "$missing_pkgs" ]; then
	echo "" >&2
	echo "ARO Desktop: some runtime dependencies appear to be missing." >&2
	echo "Install them with (recommended):" >&2
	echo "  sudo apt-get update && sudo apt-get install -y $missing_pkgs" >&2
	echo "If you installed with dpkg directly, re-run install via:" >&2
	echo "  sudo apt install ./aro-desktop*.deb" >&2
	echo "" >&2
fi


SCRIPT_DIR="$(dirname "$0")"
PROJECT_ROOT="$SCRIPT_DIR/../../../.."
BIN_SRC="$PROJECT_ROOT/apps/aro_linux/src-tauri/target/release/ARO"
BIN_DST="/usr/bin/ARO"
if [ -f "$BIN_SRC" ]; then
	install -Dm755 "$BIN_SRC" "$BIN_DST"
fi

# If the bundle installed the canonical binary (e.g. /usr/bin/aro-desktop),
# keep /usr/bin/ARO as a stable entrypoint for autostart.
if [ -x "/usr/bin/aro-desktop" ] && [ ! -e "$BIN_DST" ]; then
	ln -sf "/usr/bin/aro-desktop" "$BIN_DST" || true
fi

# Install XDG autostart desktop entry (system-wide)
APP_ID="com.aro.ARONetwork"
AUTOSTART_DST="/etc/xdg/autostart/${APP_ID}.desktop"

# 1) development source path (when running from repo)
AUTOSTART_SRC_DEV="$PROJECT_ROOT/apps/aro_linux/src-tauri/resources/etc/xdg/autostart/${APP_ID}.desktop"
# 2) packaged bundled resource path (product name may contain spaces)
AUTOSTART_SRC_BUNDLED="/usr/lib/ARO Desktop/resources/etc/xdg/autostart/${APP_ID}.desktop"
# 3) find under /usr/lib for installed bundle resources
AUTOSTART_SRC_FOUND="$(find /usr/lib -maxdepth 4 -type f -path "*/resources/etc/xdg/autostart/${APP_ID}.desktop" -print -quit 2>/dev/null || true)"

AUTOSTART_SRC=""
if [ -f "$AUTOSTART_SRC_DEV" ]; then
	AUTOSTART_SRC="$AUTOSTART_SRC_DEV"
elif [ -f "$AUTOSTART_SRC_BUNDLED" ]; then
	AUTOSTART_SRC="$AUTOSTART_SRC_BUNDLED"
elif [ -n "$AUTOSTART_SRC_FOUND" ] && [ -f "$AUTOSTART_SRC_FOUND" ]; then
	AUTOSTART_SRC="$AUTOSTART_SRC_FOUND"
fi

if [ -n "$AUTOSTART_SRC" ]; then
	install -Dm644 "$AUTOSTART_SRC" "$AUTOSTART_DST"
else
	# Fallback: create a minimal autostart entry
	install -d -m 0755 "/etc/xdg/autostart"
	cat >"$AUTOSTART_DST" <<'EOF'
[Desktop Entry]
Type=Application
Name=ARO Desktop
Comment=Start ARO Desktop on login
Exec=/usr/bin/ARO
TryExec=/usr/bin/ARO
Terminal=false
X-GNOME-Autostart-enabled=true
EOF
	chmod 0644 "$AUTOSTART_DST" || true
fi
