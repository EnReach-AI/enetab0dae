#!/bin/sh
set -e

APP_ID="com.aro.ARONetwork"
REL_DIR=".local/share/${APP_ID}"

# stop running app
pgrep -f aro-desktop | xargs -r kill -TERM || true
sleep 1
pgrep -f aro-desktop | xargs -r kill -KILL || true

# remove system desktop entry
rm -f /usr/share/applications/${APP_ID}.desktop || true

remove_dir_under_home() {
  home_dir="$1"
  if [ -d "$home_dir" ]; then
    rm -rf "$home_dir/$REL_DIR" || true
  fi
}

case "$1" in
  purge|remove)
    for d in /home/* /root; do
      if [ -d "$d" ]; then
        remove_dir_under_home "$d"
      fi
    done
    ;;
esac

exit 0