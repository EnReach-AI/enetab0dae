#!/bin/sh
set -e

APP_ID="com.aro.ARONetwork"
REL_DIR=".local/share/${APP_ID}"

# Remove XDG autostart entry (system-wide)
rm -f "/etc/xdg/autostart/${APP_ID}.desktop" || true


# 停止并禁用 systemd 服务（如存在）
if command -v systemctl >/dev/null 2>&1; then
  systemctl stop aro_linux.service || true
  systemctl disable aro_linux.service || true
  systemctl daemon-reload || true
  rm -f /etc/systemd/system/aro_linux.service || true
fi

# 停止运行的 app
pgrep -f ARO | xargs -r kill -TERM || true
sleep 1
pgrep -f ARO | xargs -r kill -KILL || true

# 移除 system desktop entry
rm -f /usr/share/applications/${APP_ID}.desktop || true

remove_dir_under_home() {
  home_dir="$1"
  if [ -d "$home_dir" ]; then
    rm -rf "$home_dir/$REL_DIR" || true
  fi
}

case "$1" in
  purge)
    for d in /home/* /root; do
      if [ -d "$d" ]; then
        remove_dir_under_home "$d"
      fi
    done
    ;;
esac

exit 0