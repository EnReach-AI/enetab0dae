#!/bin/sh
set -eu

APP_ID="com.aro.ARONetwork"

# RPM %postun runs for both uninstall and upgrade:
# - $1 == 0 : package is being erased (final uninstall)
# - $1 == 1 : package is being upgraded
# Only perform removal actions on final uninstall.
if [ "${1:-0}" != "0" ]; then
	exit 0
fi

# Remove XDG autostart entry (system-wide)
rm -f "/etc/xdg/autostart/${APP_ID}.desktop" || true

# Stop running app (best-effort)
pgrep -f ARO | xargs -r kill -TERM || true
sleep 1
pgrep -f ARO | xargs -r kill -KILL || true

# Remove system desktop entry
rm -f "/usr/share/applications/${APP_ID}.desktop" || true

# Remove installed application icons
rm -f "/usr/share/icons/hicolor/128x128/apps/${APP_ID}.png" || true
rm -f "/usr/share/pixmaps/${APP_ID}.png" || true
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
	gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
fi

# Remove binary/symlink installed by postinst
rm -f "/usr/bin/ARO" || true

# Remove user-level data (all users)
rm -rf /home/*/.config/com.aro.ARONetwork || true
rm -rf /home/*/.local/share/com.aro.ARONetwork || true
rm -rf /root/.config/com.aro.ARONetwork || true
rm -rf /root/.local/share/com.aro.ARONetwork || true



exit 0


