{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARO Desktop",
  "version": "0.1.0",
  "identifier": "com.aro.aroNetwork",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ARO Desktop",
        "width": 360,
        "height": 640,
        "minWidth": 360,
        "minHeight": 640,
        "maxWidth": 360,
        "maxHeight": 640,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "url": "https://0ee63895-262b.ipproxy.aro.network/desktop/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}